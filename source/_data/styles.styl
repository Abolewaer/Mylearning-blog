:root
  --body-bg-color #0b111d
  --content-bg-color #0b111d
  --card-bg-color #111d2e
  --text-color #c7d5e5
  --selection-bg #22506a
  --selection-color #f0fbff
  --blockquote-color #99adc5
  --link-color #96ddeb
  --link-hover-color #55f2da
  --brand-color #e1f6ff
  --brand-hover-color #55f2da
  --table-row-odd-bg-color #101e30
  --table-row-hover-bg-color #172b40
  --menu-item-bg-color #142a3a
  --theme-color #0b111d
  --btn-default-bg transparent
  --btn-default-color #64e8db
  --btn-default-border-color #326a76
  --btn-default-hover-bg #64e8db
  --btn-default-hover-color #0b111d
  --btn-default-hover-border-color #64e8db
  --highlight-background #101b2c
  --highlight-foreground #cfdeed
  --highlight-gutter-background #101b2c
  --highlight-gutter-foreground #768da8
  color-scheme dark
body
  background #0b111d
  color var(--text-color)
// Mist wraps the constrained header in a full-width column.
.column, .header
  background #0b111d
.column
  position relative
  z-index 2
  border-bottom 1px solid #1c3044
.site-title
  letter-spacing .16em
  color #e1f6ff
  text-shadow 0 0 24px rgba(67, 208, 227, .15)
.logo-line
  background #64e8db
.site-subtitle, .post-meta, .footer, .post-description
  color #93a8bf
.main-inner
  padding-top 48px
.post-title
  font-weight 600
.post-title a, h1, h2, h3, h4, h5, h6
  color #e0edf8
.post-body
  font-size 17px
  line-height 1.95
.post-body h2
  border-bottom 1px solid #25394e
  padding-bottom 10px
.post-body a
  color #64e8db
  border-bottom-color #326a76
.post-body code
  color #9be7ed
  background #142337
.post-body pre, .post-body pre code
  color #cfdeed
  background #101b2c
  text-shadow none
.token.comment, .token.prolog, .token.doctype, .token.cdata
  color #8ca3bd
.token.punctuation
  color #b6c9df
.token.property, .token.tag, .token.constant, .token.symbol, .token.deleted
  color #ff91ad
.token.boolean, .token.number
  color #c2a5ff
.token.selector, .token.attr-name, .token.string, .token.char, .token.builtin, .token.inserted
  color #83e3b8
.token.operator, .token.entity, .token.url
  color #80dae8
  background transparent
.token.atrule, .token.attr-value, .token.keyword
  color #88baff
.token.function, .token.class-name
  color #edce8d
.post-button .btn
  border-radius 5px
.menu-item a
  border-radius 5px
.menu-item-active a, .menu-item a:hover
  color #64e8db
.category-all-page .category-list-count, .tag-list-count
  background #182a3f
  color #a4bcd4
hr, .post-eof
  background #25394e
blockquote, th, td
  border-color #25394e
.search-pop-overlay
  background rgba(3, 8, 17, .8)
.search-popup
  background #111d2e
  border 1px solid #2a465e
.search-popup .search-header
  background #16263b
.search-popup input
  color #e0edf8
.search-result-list a
  color #b8dbe8
.search-keyword
  color #64e8db
.sidebar
  background #0e1827
::selection
  background #22506a
  color #f0fbff
// The decorative layer never intercepts text selection, links or scrolling.
#neural-background
  position fixed
  inset 0
  width 100%
  height 100%
  pointer-events none
  z-index 0
.main, .footer
  position relative
  z-index 1
.post-block
  background rgba(11, 17, 29, .82)
#neural-toggle
  position fixed
  right 18px
  bottom 76px
  z-index 100
  padding 6px 11px
  border 1px solid #326a76
  border-radius 20px
  background rgba(14, 29, 44, .94)
  color #64e8db
  font-size 13px
  line-height 1.6
  cursor pointer
  box-shadow 0 0 18px rgba(57, 205, 215, .09)
#neural-toggle:focus-visible
  outline 2px solid #64e8db
  outline-offset 3px
@media print
  #neural-background, #neural-toggle
    display none !important


// Pixel observatory: quiet surfaces keep long-form notes readable.
:root
  --body-bg-color #090f15
  --content-bg-color #090f15
  --brand-color #def5e8
  --link-color #a6d9be
  --link-hover-color #9bf5ae
  --menu-item-bg-color #172a27
  --btn-default-color #9bf5ae
  --btn-default-border-color #4a7860
  --btn-default-hover-bg #9bf5ae
  --btn-default-hover-color #090f15
body, button, input, textarea, select
  font-family "SimHei", "Heiti SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif
body
  background #090f15
  background-image radial-gradient(ellipse at 80% 18%, rgba(31, 74, 63, .15), transparent 45%), radial-gradient(ellipse at 12% 68%, rgba(30, 43, 78, .2), transparent 45%)
  background-attachment fixed
.column, .header
  background #090f15
.column
  border-bottom-color #263b36
.site-title
  color #def5e8
  letter-spacing .12em
.logo-line
  background #9bf5ae
.menu-item a, .post-button .btn, #neural-toggle
  border-radius 0
.menu-item-active a, .menu-item a:hover, .post-body a
  color #9bf5ae
.post-block
  background rgba(9, 15, 21, .9)
.post-body .katex
  font-size 1.12em
.post-body .katex-display
  overflow-x auto
  overflow-y hidden
  padding 16px 8px
  margin 1.4em 0
  border-left 2px solid #4a7860
  background rgba(21, 37, 43, .6)
  scrollbar-width thin
.post-body .katex-display > .katex
  white-space nowrap
.post-body eqn
  display block
#neural-toggle
  color #a8ecbb
  border-color #476657
  background #101c21
  box-shadow 3px 3px 0 #04090c
.observatory
  display grid
  grid-template-columns minmax(0, 1.1fr) minmax(280px, .9fr)
  align-items center
  gap clamp(20px, 3vw, 42px)
  padding 12px 0 28px
  margin-bottom 30px
  border-bottom 1px dashed #30443d
.observatory-copy
  min-width 0
.observatory-map
  margin 0
  position relative
  min-width 0
  color #8daa9d
  border 1px solid rgba(86, 126, 106, .2)
  background radial-gradient(ellipse at 52% 49%, rgba(42, 90, 76, .1), transparent 63%), rgba(10, 20, 25, .24)
  box-shadow inset 0 0 0 6px rgba(17, 32, 33, .2)
  clip-path polygon(0 0, calc(100% - 11px) 0, 100% 11px, 100% 100%, 11px 100%, 0 calc(100% - 11px))
.observatory-map:before, .observatory-map:after
  content ''
  position absolute
  width 4px
  height 4px
  background #8bb69f
  opacity .72
.observatory-map:before
  top 10px
  left 10px
.observatory-map:after
  bottom 10px
  right 10px
.observatory-map svg
  display block
  width 100%
  height auto
.observatory-map figcaption
  display flex
  justify-content space-between
  gap 12px
  padding 0 20px 18px
  font 10px/1.5 monospace
  letter-spacing .09em
  color #719b88
.observatory-map .map-idle, .observatory-map .map-discovery
  text-align right
.observatory-map .map-discovery
  display none
  color #b5ecc7
.observatory-map:hover .map-idle
  display none
.observatory-map:hover .map-discovery
  display inline
.observatory-map:hover .map-core
  filter drop-shadow(0 0 8px rgba(166, 244, 197, .65))
.observatory-map .map-signals rect
  transition fill .4s ease
.observatory-map:hover .map-signals rect
  fill #b1efc6
.observatory .terminal-label
  color #8eae9f
  font-size 11px
  letter-spacing .16em
  margin 0 0 26px
.observatory .terminal-label span
  color #9bf5ae
  margin-right 8px
.observatory h1
  font-size clamp(28px, 3vw, 40px)
  line-height 1.5
  letter-spacing .04em
  margin 0 0 22px
  color #e0ede7
.observatory h1 span
  color #9bf5ae
.observatory-intro
  font-size 15px
  line-height 1.9
  color #94aca4
  margin-bottom 30px
.pixel-link
  display inline-block
  padding 9px 17px
  color #0a1710
  background #a3eab3
  border 1px solid #c4ffd2
  box-shadow 4px 4px 0 #30503c
  font-size 14px
.pixel-link:hover
  color #0a1710
  background #c4ffd2
.quiet-link
  display inline-block
  margin 16px 0 0 20px
  color #96b3a4
  font-size 13px
  border-bottom 1px dashed #496456
.observatory-art
  position relative
  height 260px
  display grid
  place-items center
  background radial-gradient(ellipse, rgba(93, 188, 128, .08), transparent 66%)
.ghost-sprite
  width 192px
  height 208px
  background url('../images/cursor-ghost-idle.png') 0 0 / 1536px 208px no-repeat
  image-rendering pixelated
  transform scale(1.45)
  animation ghost-frames 2.4s steps(8) infinite
.coordinate
  position absolute
  bottom 10px
  color #6e9781
  font-size 10px
  letter-spacing .14em
.orbit
  position absolute
  width 220px
  height 150px
  border 1px dashed #294838
  transform rotate(-25deg)
.orbit-two
  width 164px
  height 218px
  border-color #20343b
  transform rotate(25deg)
.pixel-spark
  position absolute
  color #b2e8c4
.spark-one
  top 18px
  right 24px
  font-size 20px
.spark-two
  bottom 55px
  left 15px
  font-size 18px
.cursor-blink
  animation cursor-blink 1.4s steps(2, end) infinite
@keyframes ghost-frames
  to
    background-position -1536px 0
@keyframes cursor-blink
  50%
    opacity 0
.space-paused .ghost-sprite, .space-paused .cursor-blink
  animation-play-state paused
@media (prefers-reduced-motion: reduce)
  .ghost-sprite, .cursor-blink
    animation none
  .observatory-map .map-signals rect
    transition none
@media (max-width: 850px)
  .observatory
    grid-template-columns minmax(0, 1fr)
  .observatory-map
    max-width 490px
    width 100%
    justify-self center
@media (max-width: 767px)
  .observatory
    grid-template-columns 1fr
    padding 8px 4px 20px
    gap 12px
    margin-bottom 24px
  .observatory-map
    max-width 390px
    height 156px
    overflow hidden
  .observatory-map svg
    height 188px
    transform translateY(-18px)
  .observatory-map figcaption
    position absolute
    left 0
    right 0
    bottom 0
    padding 9px 12px 8px
    background linear-gradient(transparent, rgba(9, 18, 21, .92) 32%)
    font-size 9px
  .observatory-art
    height 210px
  .ghost-sprite
    transform scale(1.1)
  .orbit
    width 200px
    height 135px
  .quiet-link
    margin-left 16px
  .observatory h1
    font-size 30px


