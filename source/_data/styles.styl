body
  background #faf9f6
  color #343b38
.header
  background #faf9f6
.site-title
  letter-spacing .16em
.site-subtitle
  color #768079
.main-inner
  padding-top 48px
.post-title
  font-weight 600
.post-body
  font-size 17px
  line-height 1.95
.post-body h2
  border-bottom 1px solid #e5e7e1
  padding-bottom 10px
.post-body a
  color #396c59
.post-button .btn
  border-radius 2px
  border-color #396c59
  color #396c59
.post-button .btn:hover
  background #396c59
  color white
::selection
  background #d8e8db
