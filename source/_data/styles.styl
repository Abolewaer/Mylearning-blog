:root
  --body-bg-color #0b111d
  --content-bg-color #0b111d
  --card-bg-color #111d2e
  --text-color #c7d5e5
  --selection-bg #22506a
  --selection-color #f0fbff
  --blockquote-color #99adc5
  --link-color #96ddeb
  --link-hover-color #55f2da
  --brand-color #e1f6ff
  --brand-hover-color #55f2da
  --table-row-odd-bg-color #101e30
  --table-row-hover-bg-color #172b40
  --menu-item-bg-color #142a3a
  --theme-color #0b111d
  --btn-default-bg transparent
  --btn-default-color #64e8db
  --btn-default-border-color #326a76
  --btn-default-hover-bg #64e8db
  --btn-default-hover-color #0b111d
  --btn-default-hover-border-color #64e8db
  --highlight-background #101b2c
  --highlight-foreground #cfdeed
  --highlight-gutter-background #101b2c
  --highlight-gutter-foreground #768da8
  color-scheme dark
body
  background #0b111d
  color var(--text-color)
// Mist wraps the constrained header in a full-width column.
.column, .header
  background #0b111d
.column
  position relative
  z-index 2
  border-bottom 1px solid #1c3044
.site-title
  letter-spacing .16em
  color #e1f6ff
  text-shadow 0 0 24px rgba(67, 208, 227, .15)
.logo-line
  background #64e8db
.site-subtitle, .post-meta, .footer, .post-description
  color #93a8bf
.main-inner
  padding-top 48px
.post-title
  font-weight 600
.post-title a, h1, h2, h3, h4, h5, h6
  color #e0edf8
.post-body
  font-size 17px
  line-height 1.95
.post-body h2
  border-bottom 1px solid #25394e
  padding-bottom 10px
.post-body a
  color #64e8db
  border-bottom-color #326a76
.post-body code
  color #9be7ed
  background #142337
.post-body pre, .post-body pre code
  color #cfdeed
  background #101b2c
  text-shadow none
.token.comment, .token.prolog, .token.doctype, .token.cdata
  color #8ca3bd
.token.punctuation
  color #b6c9df
.token.property, .token.tag, .token.constant, .token.symbol, .token.deleted
  color #ff91ad
.token.boolean, .token.number
  color #c2a5ff
.token.selector, .token.attr-name, .token.string, .token.char, .token.builtin, .token.inserted
  color #83e3b8
.token.operator, .token.entity, .token.url
  color #80dae8
  background transparent
.token.atrule, .token.attr-value, .token.keyword
  color #88baff
.token.function, .token.class-name
  color #edce8d
.post-button .btn
  border-radius 5px
.menu-item a
  border-radius 5px
.menu-item-active a, .menu-item a:hover
  color #64e8db
.category-all-page .category-list-count, .tag-list-count
  background #182a3f
  color #a4bcd4
hr, .post-eof
  background #25394e
blockquote, th, td
  border-color #25394e
.search-pop-overlay
  background rgba(3, 8, 17, .8)
.search-popup
  background #111d2e
  border 1px solid #2a465e
.search-popup .search-header
  background #16263b
.search-popup input
  color #e0edf8
.search-result-list a
  color #b8dbe8
.search-keyword
  color #64e8db
.sidebar
  background #0e1827
::selection
  background #22506a
  color #f0fbff
// The decorative layer never intercepts text selection, links or scrolling.
#neural-background
  position fixed
  inset 0
  width 100%
  height 100%
  pointer-events none
  z-index 0
.main, .footer
  position relative
  z-index 1
.post-block
  background rgba(11, 17, 29, .82)
#neural-toggle
  position fixed
  right 18px
  bottom 76px
  z-index 100
  padding 6px 11px
  border 1px solid #326a76
  border-radius 20px
  background rgba(14, 29, 44, .94)
  color #64e8db
  font-size 13px
  line-height 1.6
  cursor pointer
  box-shadow 0 0 18px rgba(57, 205, 215, .09)
#neural-toggle:focus-visible
  outline 2px solid #64e8db
  outline-offset 3px
@media print
  #neural-background, #neural-toggle
    display none !important


// Pixel observatory: quiet surfaces keep long-form notes readable.
:root
  --body-bg-color #090f15
  --content-bg-color #090f15
  --brand-color #def5e8
  --link-color #a6d9be
  --link-hover-color #9bf5ae
  --menu-item-bg-color #172a27
  --btn-default-color #9bf5ae
  --btn-default-border-color #4a7860
  --btn-default-hover-bg #9bf5ae
  --btn-default-hover-color #090f15
body, button, input, textarea, select
  font-family "SimHei", "Heiti SC", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif
body
  background #090f15
  background-image radial-gradient(ellipse at 80% 18%, rgba(31, 74, 63, .15), transparent 45%), radial-gradient(ellipse at 12% 68%, rgba(30, 43, 78, .2), transparent 45%)
  background-attachment fixed
.column, .header
  background #090f15
.column
  border-bottom-color #263b36
.site-title
  color #def5e8
  letter-spacing .12em
.logo-line
  background #9bf5ae
.menu-item a, .post-button .btn, #neural-toggle
  border-radius 0
.menu-item-active a, .menu-item a:hover, .post-body a
  color #9bf5ae
.post-block
  background rgba(9, 15, 21, .9)
.post-body .katex
  font-size 1.12em
.post-body .katex-display
  overflow-x auto
  overflow-y hidden
  padding 16px 8px
  margin 1.4em 0
  border-left 2px solid #4a7860
  background rgba(21, 37, 43, .6)
  scrollbar-width thin
.post-body .katex-display > .katex
  white-space nowrap
.post-body eqn
  display block
#neural-toggle
  color #a8ecbb
  border-color #476657
  background #101c21
  box-shadow 3px 3px 0 #04090c
.observatory
  display grid
  grid-template-columns minmax(0, 1fr)
  align-items center
  gap clamp(20px, 3vw, 42px)
  padding 12px 0 28px
  margin-bottom 30px
  border-bottom 1px dashed #30443d
.observatory-copy
  min-width 0
.observatory .terminal-label
  color #8eae9f
  font-size 11px
  letter-spacing .16em
  margin 0 0 26px
.observatory .terminal-label span
  color #9bf5ae
  margin-right 8px
.observatory h1
  font-size clamp(28px, 3vw, 40px)
  line-height 1.5
  letter-spacing .04em
  margin 0 0 22px
  color #e0ede7
.observatory h1 span
  color #9bf5ae
.observatory-intro
  font-size 15px
  line-height 1.9
  color #94aca4
  margin-bottom 30px
.pixel-link
  display inline-block
  padding 9px 17px
  color #0a1710
  background #a3eab3
  border 1px solid #c4ffd2
  box-shadow 4px 4px 0 #30503c
  font-size 14px
.pixel-link:hover
  color #0a1710
  background #c4ffd2
.pixel-link span
  display inline-block
  transition transform .2s ease
.pixel-link:hover span, .pixel-link:focus-visible span
  transform translate(2px, -2px)
.pixel-link:active
  transform translate(2px, 2px)
  box-shadow 2px 2px 0 #30503c
.pixel-link:focus-visible, .quiet-link:focus-visible, .post-button .btn:focus-visible
  outline 1px solid #a3eab3
  outline-offset 5px
// A short travelling line quietly reinforces the full-article action.
.post-button .btn
  position relative
  overflow hidden
.post-button .btn:after
  content ''
  position absolute
  bottom 0
  left 0
  width 100%
  height 1px
  background currentColor
  transform scaleX(0)
  transform-origin left
  transition transform .24s ease
.post-button .btn:hover:after, .post-button .btn:focus-visible:after
  transform scaleX(1)
.quiet-link
  display inline-block
  margin 16px 0 0 20px
  color #96b3a4
  font-size 13px
  border-bottom 1px dashed #496456
.observatory-art
  position relative
  height 260px
  display grid
  place-items center
  background radial-gradient(ellipse, rgba(93, 188, 128, .08), transparent 66%)
.ghost-sprite
  width 192px
  height 208px
  background url('../images/cursor-ghost-idle.png') 0 0 / 1536px 208px no-repeat
  image-rendering pixelated
  transform scale(1.45)
  animation ghost-frames 2.4s steps(8) infinite
.coordinate
  position absolute
  bottom 10px
  color #6e9781
  font-size 10px
  letter-spacing .14em
.orbit
  position absolute
  width 220px
  height 150px
  border 1px dashed #294838
  transform rotate(-25deg)
.orbit-two
  width 164px
  height 218px
  border-color #20343b
  transform rotate(25deg)
.pixel-spark
  position absolute
  color #b2e8c4
.spark-one
  top 18px
  right 24px
  font-size 20px
.spark-two
  bottom 55px
  left 15px
  font-size 18px
.cursor-blink
  animation cursor-blink 1.4s steps(2, end) infinite
@keyframes ghost-frames
  to
    background-position -1536px 0
@keyframes cursor-blink
  50%
    opacity 0
.space-paused .ghost-sprite, .space-paused .cursor-blink
  animation-play-state paused
@media (prefers-reduced-motion: reduce)
  .ghost-sprite, .cursor-blink
    animation none
  .pixel-link span, .post-button .btn:after
    transition none
@media (max-width: 767px)
  .observatory
    grid-template-columns 1fr
    padding 8px 4px 20px
    gap 12px
    margin-bottom 24px
  .observatory-art
    height 210px
  .ghost-sprite
    transform scale(1.1)
  .orbit
    width 200px
    height 135px
  .quiet-link
    margin-left 16px
  .observatory h1
    font-size 30px



// A quiet, playable detail in the homepage margin.
.observatory
  position relative
.stellar-orbits
  position absolute
  right 0
  bottom 32px
  width 250px
  height 185px
  color #8ca89c
  font-size 11px
  z-index 2
.stellar-sky
  position absolute
  inset 0
.stellar-star
  position absolute
  width 28px
  height 28px
  padding 0
  border 0
  background transparent
  color #a2c3b0
  cursor grab
  touch-action none
  user-select none
  font-size 15px
  transition color .2s
.stellar-star:hover, .stellar-star:focus-visible
  color #e3ffe7
  text-shadow 0 0 9px #a3eab3
.stellar-star:focus-visible
  outline 1px dotted #a3eab3
.stellar-star.is-dragging
  cursor grabbing
  z-index 5
.stellar-star.is-collected
  visibility hidden
.stellar-vessel
  position absolute
  width 54px
  height 76px
  left 124px
  top 54px
  color #6d9080
  transition color .25s, filter .25s
  cursor pointer
.stellar-vessel svg
  width 100%
  height 100%
  fill rgba(117, 169, 144, .025)
  stroke currentColor
  stroke-width 1
.stellar-vessel.is-near, .stellar-orbits:focus-within .stellar-vessel, .stellar-vessel:hover
  color #bfedce
  filter drop-shadow(0 0 5px #639276)
.stellar-lights i
  position absolute
  width 2px
  height 2px
  background #c0edce
  box-shadow 0 0 5px #85c79d
.stellar-caption
  position absolute
  bottom 30px
  width 100%
  text-align center
  letter-spacing .12em
.stellar-count
  margin-left 8px
  opacity .7
.stellar-hint
  position absolute
  bottom 8px
  width 100%
  text-align center
  margin 0
  font-size 10px
  opacity 0
  transition opacity .3s
.stellar-orbits:hover .stellar-hint, .stellar-orbits:focus-within .stellar-hint
  opacity .8
.stellar-message
  position absolute
  bottom -15px
  width 100%
  text-align center
  margin 0
  font-size 11px
  color #bed9c8
.stellar-burst
  position absolute
  left 151px
  top 95px
  pointer-events none
.stellar-burst i
  position absolute
  width 2px
  height 2px
  background #d4eddf
  box-shadow 0 0 6px #8dc3aa
  animation stellar-bloom 2.2s ease-out both
  animation-delay var(--delay)
.is-gathering .stellar-vessel
  animation stellar-gather .65s ease-in both
@keyframes stellar-gather
  to
    filter drop-shadow(0 0 9px #a3eab3)
    transform scale(.9)
@keyframes stellar-bloom
  0%
    opacity 0
    transform translate(0, 0)
  12%
    opacity .9
  100%
    opacity 0
    transform translate(var(--dx), var(--dy))
@media (max-width: 1000px)
  .stellar-orbits
    position relative
    right auto
    bottom auto
    justify-self end
    margin-top -12px
@media (prefers-reduced-motion: reduce)
  .stellar-burst i, .is-gathering .stellar-vessel
    animation none
  .stellar-burst
    display none
  .stellar-vessel, .stellar-hint, .stellar-star
    transition none
@media (pointer: coarse)
  .stellar-hint
    opacity .8

// Eight faint orbital paths around a small star.
.stellar-orbits
  height 210px
.stellar-vessel
  width 160px
  height 160px
  left 65px
  top 8px
  color rgba(139, 174, 157, .14)
.stellar-vessel svg
  fill none
  stroke-width .6
.stellar-vessel.is-near, .stellar-orbits:focus-within .stellar-vessel, .stellar-vessel:hover
  color rgba(165, 210, 185, .32)
  filter none
.stellar-core
  position absolute
  left 76px
  top 76px
  width 8px
  height 8px
  border-radius 50%
  background #d2e9d5
  box-shadow 0 0 9px 2px rgba(172, 219, 181, .3), 0 0 22px rgba(161, 208, 178, .16)
.stellar-lights
  position absolute
  inset 0
.stellar-lights i
  left 79px
  top 79px
  border-radius 50%
  animation stellar-orbit var(--period) linear infinite
  transform rotate(var(--angle)) translateX(var(--radius))
.stellar-burst
  left 145px
  top 88px
.stellar-vessel:focus-visible
  outline 1px dotted #83a58f
  outline-offset 3px
  border-radius 50%
.is-gathering .stellar-vessel
  animation none
.is-gathering .stellar-lights
  transform scale(.03)
  transition transform .65s ease-in
.is-gathering .stellar-core
  box-shadow 0 0 16px 4px rgba(172, 219, 181, .55)
.is-blooming .stellar-core
  opacity .35
@keyframes stellar-orbit
  from
    transform rotate(var(--angle)) translateX(var(--radius))
  to
    transform rotate(calc(var(--angle) + 360deg)) translateX(var(--radius))
@media (prefers-reduced-motion: reduce)
  .stellar-lights i
    animation none
  .is-gathering .stellar-lights
    transition none
